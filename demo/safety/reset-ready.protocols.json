{
  "schemaVersion": 1,
  "kind": "protocols",
  "id": "synthetic.reset-ready",
  "version": "1",
  "machines": [
    {
      "id": "transfer",
      "states": [
        "new",
        "ready",
        "busy"
      ],
      "initial": "ready",
      "terminal": [
        "new",
        "ready"
      ],
      "operations": [
        {
          "symbol": "c:@F@device_init",
          "argument": 1,
          "from": [
            "new",
            "ready"
          ],
          "to": "ready"
        },
        {
          "symbol": "c:@F@device_start",
          "argument": 1,
          "from": [
