# Package

version       = "0.1.0"
author        = "puffball1567"
description   = "Annotation-driven static memory-safety checker for C/C++"
license       = "Apache-2.0"
srcDir        = "src"
bin           = @["kenbi"]

# Dependencies

requires "nim >= 2.2.0"

task test, "run the mini-format engine test suite":
  exec "nim r --hints:off -d:release tests/run_tests.nim"

task testc, "run the libclang front-end suite on real C / C++ (needs libclang)":
  exec "nim r --hints:off -d:release tests/run_tests_c.nim"

task testsafety, "build and test configured effect and protocol verification":
  mkDir "tmp"   # the suites write their scratch files under tmp/, which a fresh clone lacks
  exec "nim c --hints:off -d:release -o:kenbi src/kenbi.nim"
  exec "python3 tests/run_tests_safety.py"
  exec "python3 tests/run_tests_protocols.py"
  exec "python3 tests/run_tests_borrows.py"
  exec "python3 tests/run_tests_results.py"
  exec "python3 tests/run_tests_contexts.py"
  exec "python3 tests/run_tests_boundaries.py"
  exec "python3 tests/run_tests_boundary_results.py"
  exec "python3 tests/run_tests_composition.py"
  exec "python3 tests/run_tests_blocks.py"
  exec "python3 tests/run_tests_arguments.py"
  exec "python3 tests/run_tests_recursion.py"
  exec "python3 tests/run_tests_state_effects.py"
  exec "python3 tests/run_tests_depth.py"
  exec "python3 tests/run_tests_capacity.py"
  exec "python3 tests/run_tests_offsets.py"
  exec "python3 tests/run_tests_alignment.py"
  exec "python3 tests/run_tests_alignas.py"
  exec "python3 tests/run_tests_alignment_literals.py"
  exec "python3 tests/run_tests_artifacts.py"
  exec "python3 tests/run_tests_compilation.py"
  exec "python3 tests/run_tests_target.py"
  exec "python3 tests/run_tests_permissions.py"
  exec "python3 tests/run_tests_access_capacity.py"
  exec "python3 tests/run_tests_access_alignment.py"
  exec "python3 tests/run_tests_pointer_bindings.py"
  exec "python3 tests/run_tests_source_access.py"
  exec "python3 tests/run_tests_do_while.py"
  exec "python3 tests/run_tests_for_loops.py"
  exec "python3 tests/run_tests_unsigned_updates.py"
  exec "python3 tests/run_tests_signed_counters.py"
  exec "python3 tests/run_tests_lifetime_reentry.py"
  exec "python3 tests/run_tests_integer_parameters.py"
  exec "python3 tests/run_tests_unsigned_compound.py"
  exec "python3 tests/run_tests_pointer_formation.py"
  exec "python3 tests/run_tests_pointer_difference.py"
  exec "python3 tests/run_tests_pointer_comparison.py"
  exec "python3 tests/run_tests_pointer_value_lifetime.py"
  exec "python3 tests/run_tests_identity_pointer_cast.py"
  exec "python3 tests/run_tests_pointer_updates.py"
  exec "python3 tests/run_tests_pointer_returns.py"
  exec "python3 tests/run_tests_pointer_results.py"
  exec "python3 tests/run_tests_commuted_pointer.py"
  exec "python3 tests/run_tests_return_pointer_contract.py"
  exec "python3 tests/run_tests_return_pointer_offset.py"
  exec "python3 tests/run_tests_allocation.py"
  exec "python3 tests/run_tests_allocation_limits.py"
  exec "python3 tests/run_tests_stack_usage.py"
  exec "python3 tests/run_tests_execution_time.py"
  exec "python3 tests/run_tests_scaling.py"
  exec "python3 tests/run_tests_fixed_type_query.py"
  exec "python3 tests/run_tests_null_pointer_tracking.py"
  exec "python3 tests/run_tests_nullable_pointer_contract.py"
  exec "python3 tests/run_tests_short_circuit_access.py"
  exec "python3 tests/run_tests_conditional_access.py"
  exec "python3 tests/run_tests_conditional_pointer.py"
  exec "python3 tests/run_tests_conditional_calls.py"
  exec "python3 tests/run_tests_short_circuit_calls.py"
  exec "python3 tests/run_tests_conditional_pointer_calls.py"
  exec "python3 tests/run_tests_pointer_result_conditions.py"
  exec "python3 tests/run_tests_pointer_result_read.py"
  exec "python3 tests/run_tests_pointer_result_subscript.py"
  exec "python3 tests/run_tests_pointer_result_write.py"
  exec "python3 tests/run_tests_pointer_result_arithmetic.py"
  exec "python3 tests/run_tests_pointer_result_address.py"
  exec "python3 tests/run_tests_pointer_result_null_comparison.py"
  exec "python3 tests/run_tests_marks.py"
  exec "python3 tests/run_tests_regions.py"
  exec "python3 tests/run_tests_mmio.py"
  exec "python3 tests/run_tests_dma_acceptance.py"

task testall, "run every test suite":
  mkDir "tmp"
  exec "nim r --hints:off -d:release tests/run_tests.nim"
  exec "nim r --hints:off -d:release tests/run_tests_c.nim"
  exec "nim r --hints:off -d:release tests/run_tests_loop_bindings.nim"
  exec "nim c --hints:off -d:release -o:kenbi src/kenbi.nim"
